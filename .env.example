# Browser (safe to expose; access is constrained by Supabase RLS policies)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel server-only secrets — never prefix these with VITE_ and never commit values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CMS_ADMIN_EMAIL=your-admin-email@example.com
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-repository
GITHUB_BRANCH=main
GITHUB_CMS_BRANCH=cms-data
GITHUB_TOKEN=YOUR_FINE_GRAINED_GITHUB_TOKEN
